    // Calculate realistic travel time & distance from either live GPS or the selected Doha Zone
    function getTravelMetrics(loc) {
      const origin = userCoords || zoneCoordinates[document.getElementById('area-select').value] || zoneCoordinates["Al Waab"];
      const distKm = calculateDistanceKm(origin.lat, origin.lng, loc.lat, loc.lng);

      // Realistic Doha urban driving/walking time estimate
      let estMinutes;
      if (distKm < 0.45) {
        estMinutes = Math.max(1, Math.round(distKm * 12)); // ~5 km/h walk
        return {
          minutes: estMinutes,
          distKm,
          label: userCoords ? `${distKm.toFixed(1)} km (${estMinutes}m walk)` : `${estMinutes} min walk`
        };
      } else {
        // Doha city average speed (~30-35 km/h including traffic lights/roundabouts)
        estMinutes = Math.max(2, Math.round(distKm * 1.9));
        return {
          minutes: estMinutes,
          distKm,
          label: userCoords ? `${distKm.toFixed(1)} km (${estMinutes}m drive)` : `${estMinutes} min drive`
        };
      }
    }

